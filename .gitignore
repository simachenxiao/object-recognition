# ══════════════════════════════════════════════════════════════
#  .gitignore —— 随身物品识别
# ══════════════════════════════════════════════════════════════

# ── 虚拟环境（1.1 GB，用 setup_env.bat 重建）──────────────────
.venv/
venv/
env/
ENV/

# ── HF 模型缓存（3.5 GB，随项目目录单独拷贝，不入库）──────────
#   重建：重新跑一次脚本即自动下载（需 HF_ENDPOINT 镜像）
.hf/

# ── 文本原型缓存（约 220 KB，首次识别时自动重建）─────────────
src/.feat_cache/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 测试图（本地保留，不入库）────────────────────────────────
#   命名规范：<分类名><序号>.jpg → 手机1.jpg / 钥匙2.jpeg
#             n<序号>...          → n01_tray.png（期望被拒识）
#   参见 README §3「真值怎么来的」
物品图片/
_neg/

# ── 运行时产物 ───────────────────────────────────────────────
*.log
*.bak
_srv.log
_run.log

# ── 编辑器 / 系统 ────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
